{
  "version": 2,
  "builds": [
    {
      "src": "ReactDemo/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "/ReactDemo/dist/$1"
    }
  ],
  "env": {
    "USE_MOCK": "false",
    "NODE_ENV": "production"
  }
}
