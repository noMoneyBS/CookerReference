{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "ReactDemo/dist",
  "functions": {
    "api/**/*.js": {
      "runtime": "nodejs18.x"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "env": {
    "USE_MOCK": "false",
    "NODE_ENV": "production"
  }
}
