{
  "name": "cooker-reference",
  "version": "1.0.0",
  "description": "智能食谱推荐系统 - 全栈应用",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd ExpressDemo && npm run dev",
    "dev:frontend": "cd ReactDemo && npm run dev",
    "build": "npm run build:frontend",
    "build:frontend": "cd ReactDemo && npm run build",
    "install:all": "npm install && cd ExpressDemo && npm install && cd ../ReactDemo && npm install",
    "start": "cd ExpressDemo && npm start",
    "reset-db": "cd ExpressDemo && npm run reset-db",
    "test": "echo \"No tests specified\" && exit 0",
    "lint": "npm run lint:frontend",
    "lint:frontend": "cd ReactDemo && npm run lint"
  },
  "keywords": [
    "recipe",
    "recommendation",
    "ai",
    "react",
    "express",
    "nodejs",
    "multilingual"
  ],
  "author": "Your Name",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "your-repository-url"
  },
  "bugs": {
    "url": "your-repository-url/issues"
  },
  "homepage": "your-repository-url#readme"
}
